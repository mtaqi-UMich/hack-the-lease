{
  "manifest_version": 3,
  "name": "Hack the Lease",
  "version": "0.1.0",
  "description": "Turn the rental listing you're viewing into a scored, private comparison against your Hack the Lease priorities.",
  "key": "",
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_title": "Read this listing with Hack the Lease",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png"
    }
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "sidePanel"
  ],
  "host_permissions": [
    "https://hack-the-lease-kappa.vercel.app/*",
    "http://localhost:3000/*",
    "https://nominatim.openstreetmap.org/*"
  ],
  "optional_host_permissions": [
    "https://www.zillow.com/*",
    "https://www.apartments.com/*",
    "https://*/*",
    "http://*/*"
  ],
  "externally_connectable": {
    "matches": [
      "https://hack-the-lease-kappa.vercel.app/*",
      "http://localhost:3000/*"
    ]
  },
  "minimum_chrome_version": "116"
}