{
  "compilerOptions": {
    "target": "ES2022", "lib": ["dom", "dom.iterable", "esnext"], "module": "esnext", "moduleResolution": "bundler",
    "strict": true, "noEmit": true, "skipLibCheck": true, "resolveJsonModule": true, "esModuleInterop": true, "isolatedModules": true,
    "types": ["chrome"], "paths": { "@/*": ["../*"] }
